  "schemas": {
    "/api/schema/order": {
      "moduleName": "ORDERS",
      "actions": {
        "canCreate": true,
        "canEdit": true,
        "canDelete": true
      },
      "fields": [
        { "name": "orderNo", "label": "Order #", "type": "text", "isSearchable": true },
        { "name": "orderDate", "label": "Date", "type": "date", "isSearchable": true },
        { "name": "customerId", "label": "Customer", "type": "select", "dataSource": "/api/customers/dropdown", "isSearchable": true },
        {
          "name": "lineItems",
          "label": "Line Items",
          "type": "sub_table",
          "columns": [
            { "name": "productId", "label": "Product", "type": "select", "dataSource": "/api/products/dropdown" },
            { "name": "qty", "label": "Qty", "type": "number" },
            { "name": "price", "label": "Price", "type": "number" },
            { "name": "total", "label": "Total", "type": "number", "isReadonly": true }
          ]
        }
      ],
      "listConfig": {
        "displayColumns": ["orderNo", "orderDate", "customerId"]
      },
      "formConfig": {
        "layout": [
          {
            "type": "section",
            "title": "MAIN DETAILS",
            "fields": ["orderNo", "orderDate", "customerId"]
          },
          {
            "type": "tabs",
            "tabItems": [
              { "title": "Line Items", "fields": ["lineItems"] },
              { "title": "Attachments", "fields": [] },
              { "title": "History", "fields": [] },
              { "title": "Approvals", "fields": [] },
              { "title": "Logistics", "fields": [] }
            ]
          }
        ]
      }
    },

